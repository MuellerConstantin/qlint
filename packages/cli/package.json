{
  "name": "@qlint/cli",
  "version": "0.1.0",
  "description": "Command-line linter and formatter for Qlik load scripts, powered by @qlint/core.",
  "keywords": [
    "qlik",
    "qvs",
    "qlik sense",
    "load script",
    "linter",
    "formatter",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/MuellerConstantin/qlint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuellerConstantin/qlint.git",
    "directory": "packages/cli"
  },
  "bin": {
    "qlint": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE.md', 'LICENSE.md')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@qlint/core": "^0.1.0",
    "tsdown": "*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^25.9.1"
  }
}
